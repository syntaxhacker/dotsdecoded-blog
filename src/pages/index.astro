---
import BaseLayout from '../layouts/BaseLayout.astro'
import TagGraphDemo from '../components/demos/TagGraphDemo'
import { getCollection } from 'astro:content'
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

const tagMap = new Map<string, number>()
for (const post of posts) {
  for (const tag of post.data.tags) {
    tagMap.set(tag, (tagMap.get(tag) || 0) + 1)
  }
}
const tags = Array.from(tagMap.entries()).map(([name, count]) => ({ name, count }))

const edgeMap = new Map<string, number>()
for (const post of posts) {
  const pt = post.data.tags
  for (let i = 0; i < pt.length; i++) {
    for (let j = i + 1; j < pt.length; j++) {
      const key = [pt[i], pt[j]].sort().join('::')
      edgeMap.set(key, (edgeMap.get(key) || 0) + 1)
    }
  }
}
const edges = Array.from(edgeMap.entries()).map(([key, weight]) => {
  const [source, target] = key.split('::')
  return { source, target, weight }
})
---

<BaseLayout title="DotsDecoded" description="Deep dives into systems, tools, and the code that powers them.">
  <div class="home">
    <div class="home-left">
      <div class="home-header">
        <div style="display:flex; justify-content:space-between; align-items:center;">
          <h1>Dots_Decoded</h1>
          <button class="theme-toggle" onclick="window.__toggleTheme()">theme</button>
        </div>
        <p class="subtitle">deep dives into systems, tools & code</p>
      </div>
      <div class="search-wrapper">
        <input
          type="text"
          class="search-input"
          id="search-input"
          placeholder="search posts..."
          autocomplete="off"
        />
      </div>
      <div class="blog-list" id="blog-list">
        {posts.map((post) => (
          <a href={`/blog/${post.id}`} class="blog-card" data-title={post.data.title.toLowerCase()} data-desc={post.data.description.toLowerCase()} data-tags={post.data.tags.join(' ').toLowerCase()} data-href={`/blog/${post.id}`}>
            <div class="blog-card-title">{post.data.title}</div>
            <div class="blog-card-meta">
              <time datetime={post.data.date.toISOString()}>
                {post.data.date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}
              </time>
            </div>
            <div class="blog-card-desc">{post.data.description}</div>
            <div class="blog-card-tags">
              {post.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
    <div class="home-right">
      <TagGraphDemo client:visible tags={tags} edges={edges} />
    </div>
  </div>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', async () => {
      const input = document.getElementById('search-input')
      const list = document.getElementById('blog-list')
      if (!input || !list) return

      const cards = Array.from(list.querySelectorAll('.blog-card'))

      cards.forEach(card => {
        card.addEventListener('mouseenter', () => {
          const tags = (card.getAttribute('data-tags') || '').split(' ').filter(Boolean)
          window.dispatchEvent(new CustomEvent('posthover', { detail: { tags } }))
        })
        card.addEventListener('mouseleave', () => {
          window.dispatchEvent(new CustomEvent('posthover', { detail: { tags: null } }))
        })
      })

      let pagefind = null
      let debounce = null

      try {
        if (window.pagefind) {
          pagefind = window.pagefind
        } else {
          pagefind = await import('/pagefind/pagefind.js')
          await pagefind.init()
        }
      } catch (e) {}

      input.addEventListener('input', (e) => {
        const q = e.target.value.trim()

        const ql = q.toLowerCase()
        cards.forEach((card) => {
          const title = card.getAttribute('data-title') || ''
          const tags = card.getAttribute('data-tags') || ''
          const match = !ql || title.includes(ql) || tags.includes(ql)
          card.style.display = match ? '' : 'none'
        })

        clearTimeout(debounce)
        if (!q || !pagefind) return

        debounce = setTimeout(async () => {
          try {
            const results = await pagefind.search(q)
            if (results.results.length === 0) return
            const urls = new Set(results.results.map(r => r.url))

            cards.forEach((card) => {
              const href = card.getAttribute('href') || ''
              const match = urls.has(href)
              card.style.display = match ? '' : 'none'
            })
          } catch (e) {}
        }, 300)
      })

      window.addEventListener('taghover', (e) => {
        const tag = e.detail?.tag
        if (typeof tag === 'string') {
          const tl = tag.toLowerCase()
          cards.forEach((card) => {
            const tags = card.getAttribute('data-tags') || ''
            if (tags.includes(tl)) {
              card.classList.remove('card-dim')
            } else {
              card.classList.add('card-dim')
            }
          })
        } else {
          cards.forEach((card) => card.classList.remove('card-dim'))
        }
      })

      window.addEventListener('tagfilter', (e) => {
        const tag = e.detail?.tag
        if (!tag) return
        input.value = tag
        const tl = tag.toLowerCase()
        cards.forEach((card) => {
          const tags = card.getAttribute('data-tags') || ''
          card.style.display = tags.includes(tl) ? '' : 'none'
        })
      })
    })
  </script>
</BaseLayout>
